# Generated by setup.sh (openssl rand -hex 32)
SERVER_NSEC=

# --- Optional: run against a locally built funnelcake ------------------------
#
# The pinned ghcr.io/divinevideo/funnelcake-*:latest images are frozen at
# 2026-02-24 (divine-mobile#6594), so the local relay's kind allowlist stops at
# migration 70 and NIP-17 DMs (kinds 1059 and 10050) are rejected. To run
# against current funnelcake instead:
#
#     bash local_stack/build_funnelcake.sh
#     # Add the printed override lines below to this file.
#     mise run local_reset
#
# Set all three together — the images share a schema, and a schema-200 database
# under the frozen api binary makes GET /api/users/{pubkey}/videos return 500.
#
# FUNNELCAKE_MIGRATE_IMAGE=funnelcake-migrate:local
# FUNNELCAKE_RELAY_IMAGE=funnelcake-relay:local
# FUNNELCAKE_API_IMAGE=funnelcake-api:local
#
# Locally built images are in no registry, so the default `always` pull policy
# would fail before the local image is considered.
# FUNNELCAKE_PULL_POLICY=never
#
# Where build_funnelcake.sh looks for the checkout (default: ../divine-funnelcake).
# DIVINE_FUNNELCAKE_ROOT=/path/to/divine-funnelcake
#
# Days before the staleness warning fires (default: 45).
# The staleness check is automatically suppressed if any of the three
# FUNNELCAKE_*_IMAGE variables above are set, since that means you've
# explicitly chosen which images to run. Otherwise:
# STACK_STALE_AFTER_DAYS=45
