#include "../../Flutter/Flutter-Release.xcconfig"
#include "Warnings.xcconfig"

// Release/Profile signing defaults, indirected through variables so the Runner
// target can be overridden locally without touching tracked files.
DIVINE_RELEASE_CODE_SIGN_IDENTITY = Apple Development
DIVINE_RELEASE_CODE_SIGN_STYLE = Automatic
DIVINE_RELEASE_DEVELOPMENT_TEAM = GZCZBKH7MY
PROVISIONING_PROFILE_SPECIFIER = 

// Enable hardened runtime for notarization
ENABLE_HARDENED_RUNTIME = YES
OTHER_CODE_SIGN_FLAGS = --timestamp --options=runtime

// Optional local-only override for unsigned/dev macOS builds.
#include? "LocalRelease.xcconfig"
