# OpenVine Website Redirects

# Clean URLs - serve .html files without extension
/about /about.html 200!
/ios /ios.html 200!
/macos /macos.html 200!
/android /android.html 200!
/trending /trending.html 200!
/open-source /open-source.html 200!
/featured-viners /featured-viners.html 200!
/privacy /privacy.html 200!

# Video pages - Vine-compatible URLs
/v/* /watch.html 200

# Profile pages - Vine-compatible URLs
/u/* /profile.html 200

# Deep link fallbacks (web view when app not installed)
/video/* /watch.html 200
/profile/* /profile.html 200
/hashtag/* /search.html 200
/search/* /search.html 200